{
  "name": "dayz",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-favicons.mjs && node scripts/generate-feed.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npm run build && wrangler pages deploy out --project-name=dayz-cheats",
    "preview": "npm run build && npx --yes serve out -l 3000",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.86.0"
  }
}
